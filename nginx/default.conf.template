# Rendered at container start: ${BIRDNET_URL} comes from the environment.
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Detections, charts, audio clips and spectrograms come from BirdNET-Go.
    location /api/ {
        proxy_pass ${BIRDNET_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # Artwork and typefaces never change within one image version.
    location /art/   { expires 7d; add_header Cache-Control "public"; }
    location /fonts/ { expires 30d; add_header Cache-Control "public"; }

    location = /healthz { access_log off; return 200 "ok\n"; }
}
